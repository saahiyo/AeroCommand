{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AeroCommand Admin",
  "version": "0.1.0",
  "identifier": "com.ubuntu.aerocommand-tauri",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AeroCommand Admin",
        "width": 1280,
        "height": 800,
        "minWidth": 1100,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https: asset:; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' https://*.onrender.com http://127.0.0.1:* http://localhost:* ipc: http://ipc.localhost; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
